generator client {
  provider = "prisma-client-js"
}

// База древа — главное достояние: люди, связи, роды, журнал и заявки.
// Пользователи хранятся отдельно (data/accounts, lib/accounts.ts).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id             String   @id @default(cuid())
  lastName       String   @default("")
  firstName      String
  patronymic     String   @default("")
  lastNameNorm   String
  firstNameNorm  String
  patronymicNorm String   @default("")
  gender         String
  birthYear      Int?
  deathYear      Int?
  birthDateText  String   @default("")
  deathDateText  String   @default("")
  isLiving       Boolean?
  sourceNote     String   @default("")
  /// Кем был человек: внешность, ремесло, образование, чем запомнился.
  description    String   @default("")
  claimedClanId  String?
  inCensus1886   Boolean  @default(false)
  createdAt      DateTime @default(now())

  claimedClan  Clan?         @relation("ClaimedClan", fields: [claimedClanId], references: [id], onDelete: SetNull)
  foundedClans Clan[]        @relation("ClanFounder")
  aliases      PersonAlias[]
  asParent     ParentChild[] @relation("Parent")
  asChild      ParentChild[] @relation("Child")
  marriagesA   Marriage[]    @relation("SpouseA")
  marriagesB   Marriage[]    @relation("SpouseB")

  @@index([lastNameNorm])
  @@index([firstNameNorm])
  @@index([patronymicNorm])
  @@index([claimedClanId])
  @@index([inCensus1886])
}

model PersonAlias {
  id       String @id @default(cuid())
  personId String
  name     String
  nameNorm String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([nameNorm])
}

model Clan {
  id           String   @id @default(cuid())
  name         String
  nameNorm     String
  founderId    String?
  parentClanId String?
  createdAt    DateTime @default(now())

  founder    Person? @relation("ClanFounder", fields: [founderId], references: [id], onDelete: SetNull)
  parentClan Clan?   @relation("ClanLineage", fields: [parentClanId], references: [id], onDelete: SetNull)
  childClans Clan[]  @relation("ClanLineage")
  members    Person[] @relation("ClaimedClan")

  @@index([nameNorm])
  @@index([founderId])
}

model ParentChild {
  id         String @id @default(cuid())
  parentId   String
  childId    String
  sourceNote String @default("")
  parent     Person @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child      Person @relation("Child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model Marriage {
  id         String @id @default(cuid())
  personAId  String
  personBId  String
  sourceNote String @default("")
  personA    Person @relation("SpouseA", fields: [personAId], references: [id], onDelete: Cascade)
  personB    Person @relation("SpouseB", fields: [personBId], references: [id], onDelete: Cascade)

  @@unique([personAId, personBId])
  @@index([personAId])
  @@index([personBId])
}

/// Журнал: кто, что и когда изменил. Записи только добавляются.
model ChangeLog {
  id        String   @id @default(cuid())
  action    String
  personId  String?
  /// id аккаунта из data/accounts (без внешнего ключа — другая база).
  actorId   String?
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([personId])
  @@index([actorId])
  @@index([createdAt])
}

/// Заявка на разрушающее действие: удаление человека или слияние дублей.
/// Выполняется после подтверждения владельцем или хранителем (не автором заявки).
model ChangeRequest {
  id              String    @id @default(cuid())
  /// "person.delete" | "person.merge"
  kind            String
  /// Кого удаляем; при слиянии — карточка, которая исчезнет.
  personId        String
  /// При слиянии — карточка, которая останется.
  keepId          String?
  reason          String    @default("")
  /// Снимок на момент заявки: как выглядел человек и его связи.
  snapshot        String    @default("{}")
  /// "pending" | "approved" | "rejected" | "failed"
  status          String    @default("pending")
  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String    @default("")
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([personId])
}
