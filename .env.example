# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Обязательно -------------------------------------------------------------
# Ключ подписи входа: длинная случайная строка (например: openssl rand -base64 48).
# Если сменить — все выйдут и войдут заново.
AUTH_SECRET="замените-на-длинную-случайную-строку"

# Включите, когда сайт открывается по https (через Caddy/nginx).
# AUTH_COOKIE_SECURE="true"

# --- Для запуска без Docker (npm run dev) --------------------------------------
# Путь относительно папки prisma: база древа окажется в data/tree/tree.db.
DATABASE_URL="file:../data/tree/tree.db"
# ACCOUNTS_DIR="data/accounts"
# BACKUP_DIR="backups"

# --- Резервные копии -------------------------------------------------------------
# Как часто копировать древо (часы). Аккаунты — раз в сутки.
# TREE_BACKUP_HOURS=6

# Ключ шифрования копий для облака (от 16 символов). БЕЗ НЕГО КОПИИ НЕ РАСШИФРОВАТЬ —
# храните его отдельно от сервера (менеджер паролей, бумага в сейфе).
# BACKUP_ENCRYPTION_KEY="длинная-случайная-фраза"

# Куда отправлять: <имя удалённого хранилища rclone>:<бакет>/<папка>.
# OFFSITE_REMOTE="offsite:family-tree-backups/village"

# Настройка хранилища S3 для rclone (пример — Yandex Object Storage;
# для Selectel: ENDPOINT=s3.storage.selcloud.ru, PROVIDER=Other).
# RCLONE_CONFIG_OFFSITE_TYPE="s3"
# RCLONE_CONFIG_OFFSITE_PROVIDER="Other"
# RCLONE_CONFIG_OFFSITE_ENDPOINT="storage.yandexcloud.net"
# RCLONE_CONFIG_OFFSITE_REGION="ru-central1"
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID="..."
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY="..."
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET="true"

# Название села — показывается в шапке и на главной («Древо села <название>»).
VILLAGE_NAME=""
